# ─── Banco de dados ───────────────────────────────────────────────────────────
POSTGRES_DB=erp
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=troque_por_senha_forte

# ─── API / JWT ────────────────────────────────────────────────────────────────
# Gere um valor aleatório forte, ex: openssl rand -hex 32
JWT_SECRET=troque_por_secret_forte
# Secret para criptografia de dados sensíveis (AES 256 bits), ex: openssl rand -hex 16
CRYPTO_SECRET=0123456789abcdef0123456789abcdef
# Senha inicial para o usuário admin@erp.com (se o DataSeeder estiver ativo)
ADMIN_PASSWORD=admin123
# Origens permitidas no CORS (ex: https://erp.seu-dominio.com). Em dev: http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ─── Backup (rclone + Google Drive) ──────────────────────────────────────────
# Nome do remote configurado no rclone (ex: gdrive)
RCLONE_REMOTE=gdrive
# Pasta de destino dentro do Google Drive
RCLONE_GDRIVE_FOLDER=backups/erp
